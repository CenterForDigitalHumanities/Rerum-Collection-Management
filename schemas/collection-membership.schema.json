{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RCM CollectionMembership Body",
  "description": "Annotation body for asserting that a Thing belongs to a collection.",
  "type": "object",
  "required": ["@type", "rcm:collection"],
  "properties": {
    "@type": {
      "type": "string",
      "const": "rcm:CollectionMembership"
    },
    "rcm:collection": {
      "type": "string",
      "format": "uri",
      "description": "The @id of the collection."
    }
  },
  "additionalProperties": true
}
