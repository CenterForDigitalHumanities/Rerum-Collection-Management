{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RCM PropertyAssertion Body",
  "description": "Annotation body for asserting metadata-like claims about a target.",
  "type": "object",
  "required": ["@type", "rcm:predicate", "rcm:object"],
  "properties": {
    "@type": {
      "type": "string",
      "const": "rcm:PropertyAssertion"
    },
    "rcm:predicate": {
      "type": "string",
      "description": "The predicate being asserted (e.g., dc:creator, dc:date)."
    },
    "rcm:object": {
      "type": "string",
      "format": "uri",
      "description": "The object/value of the assertion."
    }
  },
  "additionalProperties": true
}
