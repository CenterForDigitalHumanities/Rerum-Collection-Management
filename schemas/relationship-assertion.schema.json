{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RCM RelationshipAssertion Body",
  "description": "Annotation body for asserting an edge between two nodes.",
  "type": "object",
  "required": ["@type", "rcm:predicate", "rcm:object"],
  "properties": {
    "@type": {
      "type": "string",
      "const": "rcm:RelationshipAssertion"
    },
    "rcm:predicate": {
      "type": "string",
      "description": "The relationship predicate (e.g., foaf:knows, schema:locatedIn)."
    },
    "rcm:object": {
      "type": "string",
      "format": "uri",
      "description": "The target of the relationship."
    }
  },
  "additionalProperties": true
}
